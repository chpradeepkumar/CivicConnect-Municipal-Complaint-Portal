{
  "name": "civicconnect",
  "version": "1.0.0",
  "private": true,
  "description": "CivicConnect - Municipal Complaint Portal (MERN stack)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspace server && npm run lint --workspace client",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "test:server": "npm run test --workspace server",
    "seed": "npm run seed --workspace server",
    "create-admin": "npm run create-admin --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.0",
    "globals": "^15.14.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true,
    "esbuild@0.21.5": true
  }
}
