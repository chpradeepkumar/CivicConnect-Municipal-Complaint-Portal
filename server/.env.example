# Server-side environment (copy from ../.env.example)
NODE_ENV=development
PORT=5050
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/civicconnect_portal
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_long_random_secret
COOKIE_NAME=civicconnect_token
CSRF_COOKIE_NAME=civicconnect_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
ADMIN_NAME=City Administrator
ADMIN_EMAIL=admin@civicconnect_portal.local
ADMIN_PASSWORD=ChangeMe_Str0ng!Pass
