# ------------------------------------------------------------------
# civicconnect_portal environment variables (placeholders only)
# Copy this file to `.env` (root) and to `server/.env` as needed.
# NEVER commit real credentials.
# ------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5050
API_PREFIX=/api/v1

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/civicconnect_portal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/civicconnect_portal
MONGODB_URI=mongodb://127.0.0.1:27017/civicconnect_portal

# JWT / cookies
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_long_random_secret
COOKIE_NAME=civicconnect_token
CSRF_COOKIE_NAME=civicconnect_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS (comma separated)
CLIENT_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Bootstrap admin (used only by `npm run create-admin`)
ADMIN_NAME=City Administrator
ADMIN_EMAIL=admin@civicconnect_portal.local
ADMIN_PASSWORD=ChangeMe_Str0ng!Pass

# Client (Vite) - copy relevant values to client/.env
VITE_API_BASE_URL=/api/v1
